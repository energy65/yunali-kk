<resources>

    <style name="Theme.Base" parent="Theme.Material3.DynamicColors.DayNight.NoActionBar">
        <item name="android:statusBarColor">@color/transparent</item>
        <item name="android:navigationBarColor">@color/transparent</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="textAppearanceDisplayLarge">@style/TextAppearance.App.Bold</item>
        <item name="textAppearanceDisplayMedium">@style/TextAppearance.App.Bold</item>
        <item name="textAppearanceDisplaySmall">@style/TextAppearance.App.Bold</item>
        <item name="textAppearanceHeadlineLarge">@style/TextAppearance.App.Bold</item>
        <item name="textAppearanceHeadlineMedium">@style/TextAppearance.App.Bold</item>
        <item name="textAppearanceHeadlineSmall">@style/TextAppearance.App.Bold</item>
        <item name="textAppearanceTitleLarge">@style/TextAppearance.App.Bold</item>
        <item name="textAppearanceTitleMedium">@style/TextAppearance.App.Bold</item>
        <item name="textAppearanceTitleSmall">@style/TextAppearance.App.Bold</item>
        <item name="textAppearanceBodyLarge">@style/TextAppearance.App.Bold</item>
        <item name="textAppearanceBodyMedium">@style/TextAppearance.App.Bold</item>
        <item name="textAppearanceBodySmall">@style/TextAppearance.App.Bold</item>
        <item name="textAppearanceLabelLarge">@style/TextAppearance.App.Bold</item>
        <item name="textAppearanceLabelMedium">@style/TextAppearance.App.Bold</item>
        <item name="textAppearanceLabelSmall">@style/TextAppearance.App.Bold</item>
    </style>

    <style name="TextAppearance.App.Bold" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="Theme.Splash" parent="Theme.SplashScreen">
        <item name="postSplashScreenTheme">@style/Theme.App</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
    </style>

    <style name="Theme.App" parent="Theme.Base" />

    <style name="Theme.Crash" parent="Theme.Base">
        <item name="android:windowDisablePreview">true</item>
        <item name="android:windowBackground">@color/grey_700</item>
    </style>

    <style name="Control">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:textColor">@color/yellow</item>
        <item name="android:textSize">14sp</item>
        <item name="android:padding">8dp</item>
    </style>

    <style name="ToolbarTextAppearance" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textSize">20sp</item>
        <item name="android:textColor">@color/white</item>
        <item name="titleTextColor">@color/white</item>
    </style>

</resources>
