<resources>

    <style name="Theme.Base" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/white</item>
        <item name="android:windowBackground">@color/dark_blue_bg</item>
        <item name="android:colorBackground">@color/dark_blue_bg</item>
        <item name="colorSurface">@color/dark_blue_surface</item>
        <item name="colorSurfaceContainerLowest">@color/dark_blue_bg</item>
        <item name="colorSurfaceContainerLow">@color/dark_blue_surface</item>
        <item name="colorSurfaceContainer">@color/dark_blue_surface</item>
        <item name="colorSurfaceContainerHigh">@color/dark_blue_surface</item>
        <item name="colorSurfaceContainerHighest">@color/dark_blue_surface</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowTranslucentStatus">true</item>
        <item name="android:windowTranslucentNavigation">true</item>
        <item name="android:windowAnimationStyle">@style/NoAnim</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="textAppearanceDisplayLarge">@style/TextAppearance.App.Bold</item>
        <item name="textAppearanceDisplayMedium">@style/TextAppearance.App.Bold</item>
        <item name="textAppearanceDisplaySmall">@style/TextAppearance.App.Bold</item>
        <item name="textAppearanceHeadlineLarge">@style/TextAppearance.App.Bold</item>
        <item name="textAppearanceHeadlineMedium">@style/TextAppearance.App.Bold</item>
        <item name="textAppearanceHeadlineSmall">@style/TextAppearance.App.Bold</item>
        <item name="textAppearanceTitleLarge">@style/TextAppearance.App.Bold</item>
        <item name="textAppearanceTitleMedium">@style/TextAppearance.App.Bold</item>
        <item name="textAppearanceTitleSmall">@style/TextAppearance.App.Bold</item>
        <item name="textAppearanceBodyLarge">@style/TextAppearance.App.Bold</item>
        <item name="textAppearanceBodyMedium">@style/TextAppearance.App.Bold</item>
        <item name="textAppearanceBodySmall">@style/TextAppearance.App.Bold</item>
        <item name="textAppearanceLabelLarge">@style/TextAppearance.App.Bold</item>
        <item name="textAppearanceLabelMedium">@style/TextAppearance.App.Bold</item>
        <item name="textAppearanceLabelSmall">@style/TextAppearance.App.Bold</item>
    </style>

    <style name="TextAppearance.App.Bold" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="Theme.Splash" parent="Theme.SplashScreen">
        <item name="postSplashScreenTheme">@style/Theme.App</item>
        <item name="windowSplashScreenBackground">@color/dark_blue_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
    </style>

    <style name="Theme.App" parent="Theme.Base" />

    <style name="Theme.Crash" parent="Theme.Base">
        <item name="android:windowBackground">@color/dark_blue_bg</item>
        <item name="android:windowDisablePreview">true</item>
    </style>

    <style name="NoAnim">
        <item name="android:activityOpenEnterAnimation">@null</item>
        <item name="android:activityOpenExitAnimation">@null</item>
        <item name="android:activityCloseEnterAnimation">@null</item>
        <item name="android:activityCloseExitAnimation">@null</item>
    </style>

    <style name="Shadow">
        <item name="android:shadowColor">#B0000000</item>
        <item name="android:shadowDx">1.5</item>
        <item name="android:shadowDy">1.5</item>
        <item name="android:shadowRadius">2</item>
    </style>

    <style name="Control">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/selector_chip</item>
        <item name="android:focusable">true</item>
        <item name="android:focusableInTouchMode">true</item>
        <item name="android:nextFocusUp">@id/exo_progress</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="ToolbarTextAppearance" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textSize">20sp</item>
        <item name="android:textColor">@color/white</item>
        <item name="titleTextColor">@color/white</item>
    </style>

    <style name="ToolbarTheme" parent="ThemeOverlay.Material3.Toolbar">
        <item name="selectableItemBackground">@drawable/selector_focused_red</item>
        <item name="selectableItemBackgroundBorderless">@drawable/selector_focused_red</item>
    </style>

</resources>
